{
  "manifest_version": 3,
  "name": "Chromebook 児童端末管理クライアント",
  "version": "1.5.2",
  "description": "GoogleスプレッドシートおよびGASと連携し、Chromebook児童端末の画面ロック・URL規制・一斉URL配信を行うクライアント拡張機能です。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "端末管理設定"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "tabCapture",
    "identity",
    "identity.email"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "lock.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
