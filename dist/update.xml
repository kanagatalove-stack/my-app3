<?xml version='1.0' encoding='UTF-8'?>
<gupdate xmlns='http://www.google.com/update2/response' protocol='2.0'>
  <!--
    appid   : ストア公開後に確定する32文字の拡張機能IDに書き換えてください
    codebase: extension.crx を配置した公開URLに書き換えてください
    ※ 版数は manifest.json から自動反映しています（現在 1.6.4）
  -->
  <app appid='YOUR_EXTENSION_ID_HERE'>
    <updatecheck codebase='https://YOUR_DOMAIN_OR_GITHUB_PAGES/extension.crx' version='1.6.4' />
  </app>
</gupdate>
