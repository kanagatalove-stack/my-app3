{
  "manifest_version": 3,
  "name": "Chromebook 児童端末管理クライアント（直接読み込み・検証用）",
  "version": "1.6.4",
  "description": "検証用ビルドです。管理ポリシーを使わず、ポップアップから GAS WebアプリURLを直接入力して手動同期します。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "端末管理クライアント（検証用）",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "tabs",
    "identity",
    "identity.email"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "lock.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
